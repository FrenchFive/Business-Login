# Apache: route everything that is not a real file through the front controller.
# Point the virtual host's DocumentRoot at this `public/` directory.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2|svg|png)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>
