# Dependencies (dev tools only — the app itself needs none)
/vendor/
composer.phar

# Local configuration
/.env

# Runtime data (kept as empty directories via .gitkeep)
/storage/*.sqlite
/storage/*.sqlite-*
/storage/sessions/*
/storage/mail/*
!/storage/**/.gitkeep

# Tooling caches
/.phpunit.cache/
/.phpunit.result.cache
/node_modules/

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
