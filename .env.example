# Copy to `.env` to override the defaults. Real environment variables always win.

# Product name shown in the UI and e-mails
APP_NAME=Keystone

# local | production | testing
APP_ENV=local

# Show exception messages in API errors (never enable in production)
APP_DEBUG=true

# Demo mode: seeds the "Acme Inc." workspace, shows the demo credentials on the
# sign-in page and returns password-reset links to the UI. Disable in production.
APP_DEMO=true

# Public base URL used in e-mailed links. Leave empty to use the request's Host
# header (fine locally; ALWAYS set it in production to prevent host-header attacks).
APP_URL=

# Database: sqlite (default, zero setup) or mysql (MySQL 8.0.16+ / MariaDB 10.6+)
DB_CONNECTION=sqlite

# SQLite file (relative to the project root, or absolute)
DB_PATH=storage/database.sqlite

# MySQL / MariaDB (only used when DB_CONNECTION=mysql; the database must exist,
# the tables are created automatically)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=keystone
DB_USERNAME=root
DB_PASSWORD=

# Where sessions and "sent" e-mails (.eml files) are stored
SESSION_PATH=storage/sessions
MAIL_PATH=storage/mail

# Sign out after this many minutes of inactivity
SESSION_IDLE_MINUTES=30

# Lifetime of "Keep me signed in" tokens
REMEMBER_DAYS=30

# Brute-force protection: failed sign-ins allowed per account+IP before a pause
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
