{
    "name": "frenchfive/business-login",
    "description": "A polished business login demo: PHP backend, JSON/AJAX API, vanilla JS front-end.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "ext-pdo_sqlite": "Default database driver (DB_CONNECTION=sqlite)",
        "ext-pdo_mysql": "Required for DB_CONNECTION=mysql",
        "ext-curl": "Required to run the HTTP feature tests"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/View/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php -S localhost:8000 -t public public/index.php"
        ],
        "setup": "@php bin/setup.php",
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
